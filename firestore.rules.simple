rules_version = '2';

// ============================================================
// SIMPLIFIED RULES — recovery step (ralph/firestore-nodata-fix).
// Reads: any authenticated user (get + list, all collections).
// Writes: stay role-scoped exactly as v3 (no open writes).
// Publish: paste whole file in console -> Publish -> wait 2 min ->
// EVERYONE logout+login -> verify via Diagnostics (5/5 PASS).
// Tightening user-doc reads is tracked as US-006 (later, verified).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function tokEmail() {
      return request.auth.token.email;
    }
    function tokScope() {
      return request.auth.token.name;
    }
    function tokIsSuper() {
      return tokEmail() == 'admin@recoveryx.app' || tokScope() == 'ALL';
    }
    function tokMobile() {
      return tokEmail().split('@')[0];
    }
    function tokIsScopeAdmin() {
      return tokScope() == 'ALL' || tokScope() == tokMobile();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'mobile', 'password', 'role', 'status', 'is_first_time', 'creator_mobile']) &&
             data.name is string && data.name.size() <= 128 &&
             data.mobile is string && data.mobile.size() <= 15 &&
             data.password is string && data.password.size() <= 128 &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'OFFICE_STAFF', 'NORMAL_USER'] &&
             data.status in ['ACTIVE', 'DISABLED'] &&
             data.creator_mobile is string && data.creator_mobile.size() <= 128;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['registration_number', 'owner', 'model', 'status', 'bank_name', 'creator_mobile', 'file_name']) &&
             data.registration_number is string && data.registration_number.size() <= 30 &&
             data.owner is string && data.owner.size() <= 128 &&
             data.model is string && data.model.size() <= 128 &&
             data.status is string && data.status.size() <= 30 &&
             data.bank_name is string && data.bank_name.size() <= 128 &&
             data.creator_mobile is string && data.creator_mobile.size() <= 30 &&
             data.file_name is string && data.file_name.size() <= 128;
    }

    function isValidUploadedFile(data) {
      return data.keys().hasAll(['file_name', 'admin_mobile', 'uploaded_at', 'record_count']) &&
             data.file_name is string && data.file_name.size() <= 128 &&
             data.admin_mobile is string && data.admin_mobile.size() <= 30 &&
             data.record_count is int;
    }

    function isValidSearchHistory(data) {
      return data.keys().hasAll(['user_mobile', 'user_name', 'vehicle_number', 'model', 'timestamp', 'creator_mobile']) &&
             data.user_mobile is string && data.user_mobile.size() <= 30 &&
             data.user_name is string && data.user_name.size() <= 128 &&
             data.vehicle_number is string && data.vehicle_number.size() <= 30 &&
             data.model is string && data.model.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.creator_mobile is string && data.creator_mobile.size() <= 30;
    }

    function isValidFieldPermissions(data) {
      return data.keys().hasAll(['role_string', 'role', 'show_customer_name', 'show_vehicle_number', 'show_bank_name', 'show_pos', 'show_emi', 'show_engine_number', 'show_chassis_number', 'show_confirmer_name', 'show_loan_no']) &&
             data.role_string is string && data.role_string.size() <= 128 &&
             data.role in ['NORMAL_USER', 'ADMIN'] &&
             data.show_customer_name is bool &&
             data.show_vehicle_number is bool &&
             data.show_bank_name is bool &&
             data.show_pos is bool &&
             data.show_emi is bool &&
             data.show_engine_number is bool &&
             data.show_chassis_number is bool &&
             data.show_confirmer_name is bool &&
             data.show_loan_no is bool;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['admin_mobile', 'plan_name', 'starts_at', 'expires_at', 'status']) &&
             data.admin_mobile is string && data.admin_mobile.size() <= 30 &&
             data.plan_name is string && data.plan_name.size() <= 30 &&
             data.starts_at is number &&
             data.expires_at is number &&
             data.status in ['ACTIVE', 'EXPIRED'];
    }

    // --- users ---
    match /users/{uid} {
      allow get, list: if signedIn();
      allow create: if signedIn() && isValidUser(request.resource.data) && (
        tokIsSuper() ||
        (tokIsScopeAdmin() &&
         request.resource.data.creator_mobile == tokMobile() &&
         request.resource.data.role in ['NORMAL_USER', 'OFFICE_STAFF'])
      );
      allow update: if signedIn() && (
        tokIsSuper() ||
        (tokIsScopeAdmin() &&
         resource.data.creator_mobile == tokScope() &&
         resource.data.role != 'SUPER_ADMIN' &&
         request.resource.data.role != 'SUPER_ADMIN') ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_first_time', 'registered_device_id']))
      );
      allow delete: if signedIn() && (
        (tokIsSuper() && request.auth.uid != uid) ||
        (tokIsScopeAdmin() && request.auth.uid != uid &&
         resource.data.creator_mobile == tokScope() &&
         resource.data.role != 'SUPER_ADMIN')
      );
    }

    // --- vehicles ---
    match /vehicles/{vehicleId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && isValidVehicle(request.resource.data) && (
        tokIsSuper() || request.resource.data.creator_mobile == tokMobile()
      );
      allow update, delete: if signedIn() && (
        tokIsSuper() || resource.data.creator_mobile == tokScope()
      );
    }

    // --- uploaded files ---
    match /uploaded_files/{fileId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && isValidUploadedFile(request.resource.data) && (
        tokIsSuper() || request.resource.data.admin_mobile == tokMobile()
      );
      allow update, delete: if signedIn() && (
        tokIsSuper() || resource.data.admin_mobile == tokScope()
      );
    }

    // --- search histories ---
    match /search_histories/{historyId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && isValidSearchHistory(request.resource.data);
      allow update, delete: if signedIn() && (
        tokIsSuper() || resource.data.creator_mobile == tokScope()
      );
    }

    // --- field permissions ---
    match /field_permissions/{permId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && isValidFieldPermissions(request.resource.data) && (
        tokIsSuper() ||
        (tokIsScopeAdmin() && request.resource.data.role_string == 'NORMAL_USER_' + tokMobile())
      );
      allow delete: if signedIn() && tokIsSuper();
    }

    // --- subscriptions (recharge: super-admin only writes) ---
    match /subscriptions/{adminMobile} {
      allow get, list: if signedIn();
      allow create, update, delete: if signedIn() && tokIsSuper();
    }
  }
}
